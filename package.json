{
  "name": "cruciblecpp-vscode",
  "displayName": "CrucibleCpp Preprocessor",
  "description": "Run the CrucibleCpp preprocessor on the current C/C++ file, inspect the result, and compare it with g++ -E.",
  "version": "0.4.1",
  "publisher": "tomatoOyster",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomatoOyster/cruciblecpp-vscode"
  },
  "homepage": "https://github.com/tomatoOyster/cruciblecpp-vscode#readme",
  "bugs": {
    "url": "https://github.com/tomatoOyster/cruciblecpp-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cpp",
    "preprocessor",
    "gcc",
    "mingw",
    "cruciblecpp"
  ],
  "activationEvents": [
    "onCommand:cruciblecpp.preprocess",
    "onCommand:cruciblecpp.preview",
    "onCommand:cruciblecpp.savePreprocessed",
    "onCommand:cruciblecpp.compareWithGcc",
    "onCommand:cruciblecpp.showMacroAnimation",
    "onCommand:cruciblecpp.showIncludeGraph",
    "onCommand:cruciblecpp.showGccInfo",
    "onCommand:cruciblecpp.showOutput"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cruciblecpp.preprocess",
        "title": "CrucibleCpp: Preprocess Current File"
      },
      {
        "command": "cruciblecpp.preview",
        "title": "CrucibleCpp: Preprocess and Preview to Side"
      },
      {
        "command": "cruciblecpp.savePreprocessed",
        "title": "CrucibleCpp: Save Preprocessed File"
      },
      {
        "command": "cruciblecpp.compareWithGcc",
        "title": "CrucibleCpp: Compare with g++ -E"
      },
      {
        "command": "cruciblecpp.showMacroAnimation",
        "title": "CrucibleCpp: Macro Expansion Animation"
      },
      {
        "command": "cruciblecpp.showIncludeGraph",
        "title": "CrucibleCpp: Include Graph"
      },
      {
        "command": "cruciblecpp.showGccInfo",
        "title": "CrucibleCpp: Show GCC Info"
      },
      {
        "command": "cruciblecpp.showOutput",
        "title": "CrucibleCpp: Show Output"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cruciblecpp.preview",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@90"
        },
        {
          "command": "cruciblecpp.compareWithGcc",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@91"
        },
        {
          "command": "cruciblecpp.showMacroAnimation",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@92"
        },
        {
          "command": "cruciblecpp.showIncludeGraph",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@93"
        }
      ]
    },
    "configuration": {
      "title": "CrucibleCpp",
      "properties": {
        "cruciblecpp.executable": {
          "type": "string",
          "default": "",
          "description": "Path to cruciblecpp-preprocessor.exe. Leave empty to search the workspace build/bin folders and PATH."
        },
        "cruciblecpp.gccPath": {
          "type": "string",
          "default": "",
          "description": "Path to g++.exe. Leave empty to search PATH. Used for comparison and GCC info."
        },
        "cruciblecpp.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional -I directories."
        },
        "cruciblecpp.systemIncludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional -isystem directories."
        },
        "cruciblecpp.defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional -D definitions, for example NAME or NAME=VALUE."
        },
        "cruciblecpp.undefines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional -U macro names."
        },
        "cruciblecpp.standard": {
          "type": "string",
          "enum": [
            "default",
            "c++17",
            "c++20",
            "c++23"
          ],
          "default": "default",
          "description": "Value passed to -std=. 'default' uses compile_commands.json or c++20."
        },
        "cruciblecpp.lineMarkers": {
          "type": "boolean",
          "default": false,
          "description": "Emit GNU line markers. When false, passes -P."
        },
        "cruciblecpp.inputCharset": {
          "type": "string",
          "default": "UTF-8",
          "description": "Source charset passed to -finput-charset."
        },
        "cruciblecpp.executionCharset": {
          "type": "string",
          "default": "UTF-8",
          "description": "Execution charset passed to -fexec-charset."
        },
        "cruciblecpp.unsignedChar": {
          "type": "boolean",
          "default": false,
          "description": "Pass -funsigned-char."
        },
        "cruciblecpp.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended before the input file."
        },
        "cruciblecpp.useCompileCommands": {
          "type": "boolean",
          "default": true,
          "description": "Read include paths and defines from compile_commands.json."
        },
        "cruciblecpp.compileCommandsPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to compile_commands.json. Empty means auto-detect."
        },
        "cruciblecpp.saveBeforePreprocess": {
          "type": "boolean",
          "default": true,
          "description": "Save dirty documents before preprocessing."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
